          "type": [
            "boolean",
            "null"
          ]
        },
        "outer": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "version": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "engine",
        "outer",
        "version",
        "exact"
      ],
      "type": "object"
